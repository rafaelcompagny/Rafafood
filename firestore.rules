rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myUser() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function role() { return myUser().data.role; }
    function isAdmin() { return signedIn() && role() == 'admin'; }
    function isDirector() { return signedIn() && role() == 'directeur'; }
    function isEmployee() { return signedIn() && role() == 'employe'; }
    function isManager() { return isAdmin() || isDirector() || isEmployee(); }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId && request.resource.data.role == 'client';
      allow read: if signedIn() && (request.auth.uid == userId || isManager());
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.employeeId == resource.data.employeeId
          && request.resource.data.restaurantId == resource.data.restaurantId);
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'reçue'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && (
          (
            request.resource.data.payment.status == 'paid'
            && request.resource.data.payment.provider == 'Cryptex Bank'
            && request.resource.data.payment.method in ['cryptex_bank', 'Cryptex Bank']
          )
          || (
            request.resource.data.payment.status == 'pending'
            && request.resource.data.payment.provider == 'RAFAFOOD'
            && request.resource.data.payment.method == 'pay_on_delivery'
            && request.resource.data.orderMode == 'livraison'
          )
          || (
            request.resource.data.payment.status == 'pending'
            && request.resource.data.payment.provider == 'RAFAFOOD'
            && request.resource.data.payment.method == 'pay_on_pickup'
            && request.resource.data.orderMode == 'emporter'
          )
        );

      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isManager());

      // Clients may only cancel their own received order. Staff can update operational status.
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']))
        || ((isDirector() || isEmployee())
          && resource.data.restaurantId == myUser().data.restaurantId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']))
        || (signedIn() && resource.data.userId == request.auth.uid
          && resource.data.status == 'reçue'
          && request.resource.data.status == 'annulée'
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']));

      allow delete: if isAdmin();
    }

    match /cryptexAccounts/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.balance == 2500
        && request.resource.data.currency == 'EUR'
        && request.resource.data.status == 'active';
      // Simulation uniquement : un compte ne peut pas être rechargé côté client,
      // son solde peut seulement diminuer jusqu'à 0 €.
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.balance <= resource.data.balance
        && request.resource.data.balance >= 0
        && request.resource.data.card == resource.data.card
        && request.resource.data.accountNumber == resource.data.accountNumber
        && request.resource.data.currency == resource.data.currency;
      allow delete: if false;
    }

    match /cryptexTransactions/{transactionId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'approved'
        && request.resource.data.amount > 0;
      allow update, delete: if false;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
